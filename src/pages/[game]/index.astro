---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SearchBox from "../../components/SearchBox.astro";
import { getGames } from "../../lib/games";
import { getCollection } from "astro:content";
import { homePath, routePath, stratagemsPath, challengesPath } from "../../lib/urls";

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((game) => ({
    params: { game: game.data.slug },
    props: { game },
  }));
}

const { game } = Astro.props;

const allLevels = await getCollection("levels");
const internalRoutes = [
  ...new Set(
    allLevels
      .filter((l) => l.data.game === game.data.slug && l.data.route)
      .map((l) => l.data.route as string)
  ),
].sort();

const allStratagems = await getCollection("stratagems");
const hasStratagems = allStratagems.some((s) => s.data.game === game.data.slug);

const allChallenges = await getCollection("challenges");
const hasChallenges = allChallenges.some((c) => c.data.game === game.data.slug);
---

<BaseLayout title={game.data.title}>
  <p class="top-nav">
    <a href={homePath()}>← 回到首頁</a>
    {internalRoutes.map((route) => (
      <a href={routePath(game.data.slug, route)}>{route}攻略</a>
    ))}
    {hasStratagems && <a href={stratagemsPath(game.data.slug)}>三十六計</a>}
    {hasChallenges && <a href={challengesPath(game.data.slug)}>挑戰攻略</a>}
    {game.data.externalLinks.map((link) => (
      <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
    ))}
  </p>
  <h1>{game.data.title}</h1>
  {game.data.summary && <p>{game.data.summary}</p>}

  <SearchBox gameSlug={game.data.slug} />
</BaseLayout>
