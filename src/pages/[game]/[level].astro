---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { gamePath, routePath, levelPath } from "../../lib/urls";

export async function getStaticPaths() {
  const levels = await getCollection("levels");
  return levels.map((level) => ({
    params: { game: level.data.game, level: level.data.levelId },
    props: { level },
  }));
}

const { level } = Astro.props;
const { Content } = await render(level);

const allLevels = await getCollection("levels");
const findLevel = (levelId: string) =>
  allLevels.find((candidate) => candidate.data.game === level.data.game && candidate.data.levelId === levelId);

const relatedLevels = level.data.relatedLevels.map((link) => ({ ...link, target: findLevel(link.levelId) }));
const treasures = level.data.treasures.map((treasure) => ({
  ...treasure,
  relatedLevelTarget: treasure.relatedLevel ? findLevel(treasure.relatedLevel) : undefined,
}));
const coordinateTreasures = level.data.coordinateTreasures.map((treasure) => ({
  ...treasure,
  relatedLevelTarget: treasure.relatedLevel ? findLevel(treasure.relatedLevel) : undefined,
}));
const coordinateGroups = coordinateTreasures.reduce<{ coordinates: string; items: typeof coordinateTreasures }[]>(
  (groups, treasure) => {
    const key = treasure.coordinates ?? "";
    const group = groups.find((candidate) => candidate.coordinates === key);
    if (group) {
      group.items.push(treasure);
    } else {
      groups.push({ coordinates: key, items: [treasure] });
    }
    return groups;
  },
  [],
);

const gameLevels = allLevels
  .filter((candidate) => candidate.data.game === level.data.game)
  .sort((a, b) => a.data.levelNumber - b.data.levelNumber);
const currentIndex = gameLevels.findIndex((candidate) => candidate.data.levelId === level.data.levelId);
const previousLevel = currentIndex > 0 ? gameLevels[currentIndex - 1] : undefined;
const nextLevel = currentIndex < gameLevels.length - 1 ? gameLevels[currentIndex + 1] : undefined;
---

<BaseLayout title={`第 ${level.data.levelNumber} 關：${level.data.title}`}>
  <p>
    <a href={level.data.route ? routePath(level.data.game, level.data.route) : gamePath(level.data.game)}>← 關卡列表</a>
    {
      previousLevel && (
        <>
          {" "}
          ｜ <a href={levelPath(level.data.game, previousLevel.data.levelId)}>← 上一關</a>
        </>
      )
    }
    {
      nextLevel && (
        <>
          {" "}
          ｜ <a href={levelPath(level.data.game, nextLevel.data.levelId)}>下一關 →</a>
        </>
      )
    }
  </p>
  <h1>第 {level.data.levelNumber} 關：{level.data.title}</h1>

  <Content />

  {
    level.data.storyChoices.length > 0 && (
      <>
        <h2>劇情選項</h2>
        <ul class="story-choices">
          {level.data.storyChoices.map((choice) => (
            <li>
              {choice.description}
              <ul>
                {choice.options.map((option) => (
                  <li>{option}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    level.data.coordinateTreasures.length > 0 && (
      <>
        <h2>座標寶物</h2>
        <ul class="treasure-list">
          {coordinateGroups.map((group) => (
            <li>
              {group.coordinates && <>（座標：{group.coordinates}） </>}
              {group.items.map((treasure, index) => (
                <>
                  {index > 0 && "，"}
                  <strong>{treasure.name}</strong>
                  {treasure.requiresSkin && <> （需要角色皮膚：{treasure.requiresSkin}）</>}
                  {treasure.relatedLevelTarget && (
                    <>
                      （關聯：
                      <a href={levelPath(level.data.game, treasure.relatedLevelTarget.data.levelId)}>
                        第 {treasure.relatedLevelTarget.data.levelNumber} 關：{treasure.relatedLevelTarget.data.title}
                      </a>
                      ）
                    </>
                  )}
                </>
              ))}
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    level.data.treasures.length > 0 && (
      <>
        <h2>寶物</h2>
        <ul class="treasure-list">
          {treasures.map((treasure) => (
            <li>
              <strong>{treasure.name}</strong>：{treasure.condition}
              {treasure.requiresSkin && <> （需要角色皮膚：{treasure.requiresSkin}）</>}
              {treasure.relatedLevelTarget && (
                <>
                  （關聯：
                  <a href={levelPath(level.data.game, treasure.relatedLevelTarget.data.levelId)}>
                    第 {treasure.relatedLevelTarget.data.levelNumber} 關：{treasure.relatedLevelTarget.data.title}
                  </a>
                  ）
                </>
              )}
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    level.data.seal && (
      <>
        <h2>印綬</h2>
        <p>{level.data.seal}</p>
      </>
    )
  }

  {
    level.data.specialEvents.length > 0 && (
      <>
        <h2>特殊劇情</h2>
        <ul class="special-events">
          {level.data.specialEvents.map((event) => <li>{event}</li>)}
        </ul>
      </>
    )
  }

  {
    relatedLevels.length > 0 && (
      <>
        <h2>關卡關聯</h2>
        <ul class="related-levels">
          {relatedLevels.map((link) =>
            link.target ? (
              <li>
                <a href={levelPath(level.data.game, link.target.data.levelId)}>
                  第 {link.target.data.levelNumber} 關：{link.target.data.title}
                </a>
                　－　{link.relation}
              </li>
            ) : (
              <li>{link.relation}（找不到關卡 {link.levelId}）</li>
            ),
          )}
        </ul>
      </>
    )
  }

  <p class="source-link">
    <a href={level.data.sourceUrl} target="_blank" rel="noopener noreferrer">原文出處</a>
  </p>
</BaseLayout>
